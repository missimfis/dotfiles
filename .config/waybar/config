{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    "modules-right": ["network", "backlight", "cpu", "memory", "battery", "clock", "tray"],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{index}"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    },

    "battery": {
        "bat": "BAT0",
        "states": {
            "full": 99,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "interface": "wlan0",
        "format-wifi": " {essid} {signalStrength}%",
        "format-disconnected": " --",
        "interval": 10
    },

    "backlight": {
        "device": "intel_backlight",
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl s 5%+",
        "on-scroll-down": "brightnessctl s 5%-"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },

    "memory": {
        "format": " {used:0.1f}G",
        "interval": 5
    }
}

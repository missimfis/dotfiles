# Nord Notifications

sort=-time
layer=overlay
background-color=#2e3440
text-color=#d8dee9
width=350
height=120
border-size=2
border-color=#88c0d0
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
font=JetBrains Nerd Font 11
anchor=bottom-right
margin=12

# Progress bar
progress-color=over #3b4252

[urgency=low]
border-color=#a3be8c
background-color=#2e3440

[urgency=normal]
border-color=#88c0d0
background-color=#2e3440

[urgency=high]
border-color=#bf616a
background-color=#2e3440
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

# App specific
[app-name="volume"]
border-color=#b48ead

[app-name="brightness"]
border-color=#ebcb8b

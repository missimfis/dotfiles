#!/usr/bin/env zsh
set -euo pipefail

MODE="${1:-area}"
OUT_DIR="${HOME}/Pictures/screenshots"
mkdir -p "$OUT_DIR"

case "$MODE" in
    area)
        FILE="${OUT_DIR}/$(date +%Y%m%d-%H%M%S).png"
        grim -g "$(slop -f '%x,%y,%w,%h')" "$FILE" && wl-copy < "$FILE"
        notify-send "Screenshot saved" "$FILE"
        ;;
    screen)
        FILE="${OUT_DIR}/$(date +%Y%m%d-%H%M%S)-full.png"
        grim "$FILE" && wl-copy < "$FILE"
        notify-send "Screenshot saved" "$FILE"
        ;;
    copy)
        grim -g "$(slop -f '%x,%y,%w,%h')" - | wl-copy
        notify-send "Screenshot copied to clipboard"
        ;;
    *) echo "Usage: screenshot [area|screen|copy]"; exit 1 ;;
esac

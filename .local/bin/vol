#!/usr/bin/env zsh
set -euo pipefail

SINK="@DEFAULT_AUDIO_SINK@"

case "${1:-}" in
    up) wpctl set-volume "$SINK" +5% 2>/dev/null || true ;;
    down) wpctl set-volume "$SINK" -5% 2>/dev/null || true ;;
    +([[:digit:]])*) wpctl set-volume "$SINK" +"${1#+}"% 2>/dev/null || true ;;
    -([[:digit:]])*) wpctl set-volume "$SINK" "${1#-}"% 2>/dev/null || true ;;
    mute) wpctl set-mute "$SINK" toggle 2>/dev/null || true ;;
    unmute) wpctl set-mute "$SINK" off 2>/dev/null || true ;;
    toggle) wpctl set-mute "$SINK" toggle 2>/dev/null || true ;;
    get|status) 
        output=$(wpctl get-volume "$SINK" 2>&1)
        if echo "$output" | grep -q "Invalid"; then
            echo " VOL --"
        else
            vol=$(echo "$output" | awk '{print int($2*100)}')
            echo "$output" | grep -q "MUTED yes" && echo " VOL M" || echo " VOL ${vol}"
        fi
        ;;
    *) wpctl get-volume "$SINK" 2>/dev/null || echo " VOL --" ;;
esac

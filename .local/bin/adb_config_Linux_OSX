#!/bin/sh
set -e
# adb configuration script
PATH=$PATH:/bin:/sbin:/usr/sbin
ANDROID_HOME="${HOME}/.android"
ANDROID_CONFIG="${HOME}/.android/adb_usb.ini"
CUST_VID="0x2a70"

if [ -e "$ANDROID_HOME" ] ; then
   echo "android home exists"
else
   echo "create android home"
   mkdir -p "$ANDROID_HOME"
fi

if grep "$CUST_VID" "$ANDROID_CONFIG" 2>/dev/null ; then
   echo "VID ${CUST_VID} is already configured"
   echo "adb should be OK!"
   exit 0
else
   echo "config adb ..."
   echo "$CUST_VID" >> "$ANDROID_CONFIG"
fi

if adb kill-server ; then
  echo "OK! You can use adb now!"
  exit 0
else
   echo "try sudo exec adb.."
   if sudo adb kill-server ; then
       echo "OK! You can use adb now!"
       exit 0
   else
       echo "Please do command \"adb kill-server\""
       exit 1
   fi
fi



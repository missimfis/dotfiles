#!/usr/bin/env zsh
set -euo pipefail
IFS=$'\n\t'

log() { printf '[%s] %s\n' "$(date '+%H:%M')" "$*"; }
die() { log "ERROR: $*"; exit 1; }

log "Syncing package databases..."
sudo aura -Sy --noconfirm || die "Failed to sync repos"

log "Upgrading official packages..."
sudo aura -Syu --noconfirm || die "System upgrade failed"

log "Upgrading AUR packages..."
sudo aura -Ayu --noconfirm || die "AUR upgrade failed"

if command -v cargo >/dev/null 2>&1; then
    if command -v cargo-install-update >/dev/null 2>&1; then
        log "Updating cargo binaries..."
        cargo install-update --all 2>/dev/null || log "Cargo update failed (non-critical)"
    else
        log "Skipping cargo update (cargo-install-update not installed)"
    fi
fi

if command -v freshclam >/dev/null 2>&1; then
    if [[ -w /var/lib/clamav ]]; then
        log "Updating clamav signatures..."
        sudo freshclam 2>/dev/null || log "ClamAV update failed (non-critical)"
    fi
fi

log "System update complete!"

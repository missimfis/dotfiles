#!/usr/bin/env zsh
# Network traffic monitor for waybar (temp-file-free)
# Usage: net-traffic [interface]

INTERFACE="${1:-wlan0}"

get_stats() {
    awk -v iface="$INTERFACE" '$1 ~ iface":" {print $2, $10}' /proc/net/dev
}

format() {
    local rate=$1
    if (( rate > 1048576 )); then
        printf "%.1fM" $((rate / 1048576))
    elif (( rate > 1024 )); then
        printf "%.0fK" $((rate / 1024))
    else
        printf "%dB" "$rate"
    fi
}

while true; do
    read -r prev_rx prev_tx <<<"$(get_stats)"
    sleep 1
    read -r curr_rx curr_tx <<<"$(get_stats)"

    [[ -z "$prev_rx" || -z "$curr_rx" ]] && { echo "⬇ 0B ⬆ 0B"; sleep 1; continue }

    rx_rate=$((curr_rx - prev_rx))
    tx_rate=$((curr_tx - prev_tx))

    printf "⬇ %s ⬆ %s\n" "$(format "$rx_rate")" "$(format "$tx_rate")"
done
